---
layout: norn-docs.webc
pagination:
  data: webcdoc.components
  size: 1
  alias: component
---
<p class="lede" webc:if="component.summary" @text="component.summary"></p>
<p webc:if="component.description" @text="component.description"></p>
<p webc:if="component.deprecated" class="deprecated">This component is deprecated.</p>
<p class="requires" webc:if="requires.length">
  Requires:
  <span webc:for="item of requires"><span @text="item.kind"></span> <code @text="item.name"></code>.</span>
</p>
<p webc:if="!component.summary && !component.description" class="empty">This component has no documentation comments yet. Its props, slots, and data are listed from the template alone.</p>
<p webc:if="!requires.length">Requires nothing from the host.</p>

<h2>Props</h2>
<table webc:if="component.props.length">
  <thead>
    <tr><th scope="col">Prop</th><th scope="col">Attribute</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Description</th></tr>
  </thead>
  <tbody>
    <tr webc:for="prop of component.props">
      <td><code @text="prop.name"></code></td>
      <td><code @text="prop.attribute"></code></td>
      <td><code @text="prop.type?.text ?? ''"></code></td>
      <td><code @text="prop.default ?? ''"></code></td>
      <td><span @text="prop.description"></span><span webc:if="prop.optional"> Optional.</span></td>
    </tr>
  </tbody>
</table>
<p webc:if="!component.props.length">No props are documented.</p>

<h2>Slots</h2>
<table webc:if="component.slots.length">
  <thead>
    <tr><th scope="col">Slot</th><th scope="col">Description</th><th scope="col">Fallback</th></tr>
  </thead>
  <tbody>
    <tr webc:for="slot of component.slots">
      <td><code @text="slot.name || 'default'"></code></td>
      <td @text="slot.description"></td>
      <td @text="slot.hasFallback ? 'Yes' : 'No'"></td>
    </tr>
  </tbody>
</table>
<p webc:if="!component.slots.length">No slots are documented.</p>

<h2>CSS custom properties</h2>
<table webc:if="component.cssProperties.length">
  <thead>
    <tr><th scope="col">Property</th><th scope="col">Syntax</th><th scope="col">Default</th><th scope="col">Description</th></tr>
  </thead>
  <tbody>
    <tr webc:for="cssProperty of component.cssProperties">
      <td><code @text="cssProperty.name"></code></td>
      <td><code @text="cssProperty.syntax ?? ''"></code></td>
      <td><code @text="cssProperty.default ?? ''"></code></td>
      <td @text="cssProperty.description"></td>
    </tr>
  </tbody>
</table>
<p webc:if="!component.cssProperties.length">No CSS custom properties are documented.</p>

<h2>CSS parts</h2>
<table webc:if="component.cssParts.length">
  <thead>
    <tr><th scope="col">Part</th><th scope="col">Description</th></tr>
  </thead>
  <tbody>
    <tr webc:for="part of component.cssParts">
      <td><code @text="part.name"></code></td>
      <td @text="part.description"></td>
    </tr>
  </tbody>
</table>
<p webc:if="!component.cssParts.length">No CSS parts are documented.</p>

<h2>Examples</h2>
<div webc:for="example of component.examples">
  <h3 @text="example.title"></h3>
  <pre><code @text="example.code"></code></pre>
</div>
<p webc:if="!component.examples.length">No examples are documented.</p>

<h2>Warnings</h2>
<ul webc:if="component.warnings.length">
  <li webc:for="warning of component.warnings"><code @text="warning.code"></code> line <span @text="warning.line"></span>: <span @text="warning.message"></span></li>
</ul>
<p webc:if="!component.warnings.length">This component has no warnings.</p>

{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"custom-elements-manifest/schema": [
				"./node_modules/custom-elements-manifest/schema.d.ts"
			]
		}
	},
	"include": [
		"packages/*/src",

{
  "private": true,
  "name": "webc-docs",
  "version": "0.0.0",
  "description": "Monorepo for webcdoc, a parser that turns JSDoc-style comments in WebC components into JSON documentation metadata.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allonsy-studio/webc-docs.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "site"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A --topological run build",
    "ci": "yarn workspaces foreach -A --topological run ci",
    "format": "opx lint --fix",
    "lint": "opx lint",
    "prepare": "husky",
    "release": "yarn build && opx release publish",
    "test": "yarn workspaces foreach -A run test",
    "typecheck": "tsc -p tsconfig.test.json",
    "version-packages": "opx release version && yarn install --mode update-lockfile"
  },
  "devDependencies": {
    "@allons-y/opx-cli": "^0.1.0-beta.0",
    "@allons-y/opx-lint-js": "^0.1.0-beta.0",
    "@allons-y/opx-lint-json": "^0.1.0-beta.0",
    "@allons-y/opx-lint-md": "^0.1.0-beta.0",
    "@allons-y/opx-release": "^0.1.0-beta.0",
    "@changesets/changelog-github": "^1.0.1",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-license-header": "^0.9.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions",
    "not dead"
  ],
  "packageManager": "yarn@4.18.1"
}
